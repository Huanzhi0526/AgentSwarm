{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSwarm",
  "version": "1.4.0",
  "identifier": "io.github.huanzhi0526.agentswarm",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/prepare-tauri-bundle.mjs",
    "frontendDist": "boot-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentSwarm · 多智能体协同看板",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle-stage/runtime/": "runtime/",
      "bundle-stage/app/": "app/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
